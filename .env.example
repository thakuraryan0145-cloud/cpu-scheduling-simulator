# Django Core
SECRET_KEY=replace-with-a-strong-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration
# Use "postgresql" for production / PostgreSQL, or "sqlite" for local quickstart
DB_ENGINE=postgresql
DB_NAME=cpu_scheduler_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# Email Configuration (console backend prints verification/reset links to terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@cpuscheduler.local

# Frontend / CORS
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
